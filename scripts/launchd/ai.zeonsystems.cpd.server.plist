<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.zeonsystems.cpd.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/devanshgaur/Documents/Projects/CorticalPersuasionDecoder/server/.venv/bin/python</string>
        <string>-u</string>
        <string>server.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/devanshgaur/Documents/Projects/CorticalPersuasionDecoder/server</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CPD_BRAINMAP_MODE</key>
        <string>text</string>
        <key>CPD_CONFIDENCE_TEMP</key>
        <string>0.25</string>
    </dict>

    <!-- Start at login and keep it alive: relaunch if it ever exits/crashes. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Don't hammer-restart: wait 10s between respawns after a crash. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/devanshgaur/Library/Logs/cpd_server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/devanshgaur/Library/Logs/cpd_server.log</string>
</dict>
</plist>
